NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI to register there: http://localhost:3000/api/auth/callback/google
# (add the equivalent https://<your-domain>/api/auth/callback/google once deployed)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Get these from https://console.upstash.com — create a free Redis database,
# then copy the REST URL and token from its dashboard. Powers the
# never-reused Anonymous #N visitor counter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Get this from https://console.anthropic.com/settings/keys — powers the
# "Generate using AI" button on the Create Room description step. Optional:
# without it, that button just fails with an error instead of the app
# refusing to start.
ANTHROPIC_API_KEY=

# Web Push keys for "Notify me of new messages" in room chats. Generate a pair
# with: npx web-push generate-vapid-keys
# The public key is shared with browsers; keep the private key secret.
# Optional: without them the notification switch just doesn't appear.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
